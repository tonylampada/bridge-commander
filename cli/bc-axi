    '  notify [--kind K] [--text-file f|-]    board-level notification (no card)\n' +
    '  say <lieutenant:ID|card:ID> [--actor a] [--text-file f|-]\n' +
    '                                         post a chat message; a card thread\'s interlocutor is\n' +
    '                                         the owning lieutenant (lieutenant-main says also notify).\n' +
    '                                         A card-thread say by anyone but the owner (e.g. its\n' +
    '                                         worker) also queues a worker-said item waking the owner\n' +
    '\nthe line (the captain\'s voice channel — one holder, server-side):\n' +
    '  line [--json]                          who holds it now. The captain\'s voice shortcut posts\n' +
    '                                         {"target":"line"} and names nobody; the line follows\n' +
    '                                         whoever last spoke to him in a main chat, and falls\n' +
    '                                         back to the founding lieutenant on a silent board\n' +
    '  line pass <lieutenant-id> --note "<what he wants from them>"\n' +
    '                                         hand it over: the receiver is WOKEN with the note\n' +
    '                                         (a real delivery), and greets him in one line first\n' +
    '\ndelivery (at-least-once):\n' +
    '  drain [--lieutenant <id>] [--json]     print pending QueueItems with card context and a\n' +
    '    next-action hint per item (--json: raw JSON lines). Captain messages, start/rework\n' +
    '    orders, card-created/moved. Drain never removes: handle the items, then ack the\n' +
    '    highest seq handled; unacked items re-offer (dedupe by seq)\n' +
    '  ack <seq>                              commit that seq\'s lieutenant ack cursor\n' +
    '\nstatus (worker lease; owed/unread are server-derived):\n' +
    '  status <card-id> [--json]              the card\'s derived status: worker/owed/unread\n' +
    '  status <card-id> <state> --worker <id> [--ttl <secs>]\n' +
    '                                         status.set: link worker + state (absent|idle|working|needs-you)\n' +
    '                                         as a lease; past the TTL (default 600s) working/needs-you\n' +
    '                                         decays to idle; "status <card-id> absent" unlinks\n' +
    '\nconfig:\n' +
    '  config show | config voices "a,b"      TTS voice filter for the UI\n' +
    '\nText/body/charter always via --text-file/--body-file/--charter-file or stdin ("-"), never shell-interpolated.\n' +
    'The charter is not board state: --charter-file creates lieutenants/<id>/README.md in the workspace\n' +
    'when it is absent, and never replaces one — edit the file to change a charter.');
  // The last line of the help screen is the one still on screen when an agent
  // stops reading: if the running server is behind its checkout, it says so
  // here. A down server, an unknown commit, or a match all print nothing extra.
  driftNote().then((n) => die(usage + (n ? '\n\n⚠ ' + n : '')), () => die(usage));
} else {
  commands[cmd]().catch((e) => die(e.message));
}
