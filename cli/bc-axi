      : run.code === null ? 'killed' : 'exit ' + run.code;
    console.log(hhmm(run.started) + '  ' + run.hook + '  ' + run.trigger
      + (run.card ? ' ' + run.card : '') + '  ' + how + '  ' + run.ms + 'ms');
    if (run.output) console.log('    ' + run.output.replace(/\n/g, '\n    '));
  }
}

