}

// ---------- card writes ----------
async function cmdCreate() {
  if (!opts.title || !opts.owner) {
    die('usage: bc-axi card create --title T --owner <lieutenant> [--type plan|implementation|investigation]\n' +
      '                    [--playbook <id>] [--body-file f|-] [--attr k=v]... [--label l]...\n' +
      '                    (cards are born in Backlog)\n' +
      '  The owner mints the id (<PREFIX>-<n>, e.g. MON-14).\n' +
      '  --playbook names a file in <workspace>/.bridge-commander/playbooks/ (bc-axi playbook list).\n' +
      '  A card with no playbook cannot start — set one here or with card patch --playbook.');
  }
  if (opts.id) {
    // The owner mints the id — refuse locally, before any create, and name the
    // id it would have minted (the same prefix+cardSeq compute cmdLtList does).
    // The lookup is a courtesy: the refusal is local policy and stands whether
    // or not a server is there to answer.
    let minted = null;
    try {
      const lr = await request('GET', '/api/lieutenants');
      const lt = (lr.lieutenants || []).find((l) => l.id === opts.owner);
      if (lt) minted = lt.prefix + '-' + ((Number.isInteger(lt.cardSeq) ? lt.cardSeq : 0) + 1);
    } catch (e) { minted = null; }
    die('card create refused: the owner mints the id, --id is not accepted.' +
      (minted ? ' ' + opts.owner + ' would mint ' + minted + ' next.' : ''));
  }
  const body = {
    title: opts.title, owner: opts.owner, actor: opts.actor || 'agent',
    attributes: parseAttrs(opts.attrs), labels: opts.labels,
  };
  if (opts.type) body.type = opts.type;
  if (opts.playbook !== null) body.playbook = opts.playbook;
  if (opts.column) body.column = opts.column;
  if (opts.bodyFile) body.body = readInput(opts.bodyFile);
  // A duplicate id is refused, never resolved: print the server's sentence as
  // its own line so the human reads what to do instead of an HTTP envelope.
  // The server offers two remedies because an API caller has both; here the id
  // is always the mint, so drop the door this command no longer has and leave
  // the one a CLI caller can walk through.
  let r;
  try { r = await request('POST', '/api/cards', body); }
  catch (e) {
    if (!(e.status === 409 && e.body && e.body.error)) die(e.message);
    die('card create refused: ' +
      e.body.error.replace(/\s*Create it with an explicit free id, or give /, ' Give '));
  }
  console.log('created ' + r.card.id + ' in ' + r.card.column);
}

async function cmdMove() {
  const id = positional[0], column = positional[1];
  if (!id || !column) die('usage: bc-axi card move <card-id> <column> [--actor a] [--level 1|2] [--kind k]\n  (lieutenant moves land only in review — the handoff)');
  const body = { column, actor: opts.actor || 'agent' };
  if (opts.level) body.level = opts.level;
  if (opts.kind) body.kind = opts.kind;
  // the handoff out of Working awaits the worktree release, which queues behind
  // whatever else holds the project clone's lock (a concurrent `card start`
  // fetches and adds a worktree under the same lock) — same budget as start
  const r = await request('POST', '/api/cards/' + encodeURIComponent(id) + '/move', body, 180000);
