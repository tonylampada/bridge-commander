  if (!r.hooks.length) return console.log('no hooks (drop an executable file in ' + r.dir + ')');
  for (const h of r.hooks) {
    console.log(h.name + '\t' + (h.event || 'named') + '\t' + runOutcome(h.last)
      + (h.running ? '\t(running now)' : ''));
  }
  console.log('\n' + r.dir + ' — a file is a NAMED hook (bc-axi hook run <name>); a directory is a lifecycle event');
}

async function cmdHookRun() {
  const name = positional[0];
  if (!name) {
    die('usage: bc-axi hook run <name> [--card <card-id>] [--trigger <name>]\n' +
      '  Run a NAMED hook — an executable file directly in <workspace>/.bridge-commander/hooks/.\n' +
      '  This is the one door: an outside trigger on this machine, the board\'s ▶ and a schedule\n' +
      '  all come through it, and every run appends a line to hookruns.jsonl (bc-axi hook runs).\n' +
      '  --card hands the hook BC_CARD/BC_WORKTREE/BC_BRANCH; without it they are empty.\n' +
      '  --trigger names who called (default "cli") and is what the trace line records.\n' +
      '  A second run while the first is in flight is REFUSED, naming the one already going.');
  }
  const body = { name, trigger: opts.trigger || 'cli' };
  if (opts.card) body.card = opts.card;
  let r;
  try {
    // The hook's own timeout (~120s by default) is the server's budget, so wait
    // past it rather than reporting a timeout the hook never had.
    r = await request('POST', '/api/hooks/run', body, 600000);
  } catch (e) {
    if (e.status === 409 || e.status === 404) die((e.body && e.body.error) || e.message);
    throw e;
  }
  const run = r.run;
  if (run.output) process.stdout.write(run.output.endsWith('\n') ? run.output : run.output + '\n');
  const how = run.timedOut ? 'TIMED OUT' : run.error ? 'FAILED TO START (' + run.error + ')'
    : run.code === null ? 'KILLED' : 'exit ' + run.code;
  console.log('hook ' + name + ' ' + how + ' in ' + run.ms + 'ms (trigger ' + run.trigger + ')');
  // exitCode, not exit(): the output tail written just above is what this command
  // exists to show, and process.exit() would drop it on the way through a pipe.
  if (!run.ok) process.exitCode = 1; // the caller's own exit code follows the hook's
}

async function cmdHookRuns() {
