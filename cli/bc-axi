      '  ONE atomic op: provision an isolated worktree, spawn the worker session with the brief\n' +
      '  as launch prompt, bind session/worktree/branch to the card, move it to Working.\n' +
      '  --brief-file adds/overrides the task text (default: the card body).\n' +
      '  --resume reincarnates the card\'s recorded (dead) worker in the same worktree.\n' +
      '  --model overrides the spawned worker\'s model (e.g. claude-fable-5); ignored with --resume.\n' +
      '  --effort sets reasoning effort (low|medium|high|xhigh|max) for a claude worker; ignored with --resume.');
  }
  if (opts.resume && opts.briefFile) {
    die('--resume does not deliver briefs: the reincarnated worker keeps its own context and the\n' +
      'brief would be silently dropped. To hand a live worker new instructions:\n' +
      '  bc-axi worker send ' + id + ' --text-file <f|->');
  }
  const body = { actor: opts.actor || 'agent' };
  if (opts.briefFile) body.brief = readInput(opts.briefFile);
  if (opts.resume) body.resume = true;
  if (opts.harness) body.harness = opts.harness;
  if (opts.model) body.model = opts.model;
  if (opts.effort) body.effort = opts.effort;
  console.log((opts.resume ? 'resuming' : 'starting') + ' a worker for ' + id + ' (worktree + real session — can take a minute)...');
  // Five minutes, because everything this waits on is slow and real: a cold
  // clone of a big repo, and on a rework restart the previous run's teardown
  // (capped at 60s server-side) before provisioning even begins. A caller that
  // gives up early sees a timeout while the worker starts perfectly well behind
  // it — and cannot retry, since the start is already in flight.
  const r = await request('POST', '/api/cards/' + encodeURIComponent(id) + '/start', body, 300000);
  const w = r.worker;
  console.log((r.resumed ? 'resumed' : 'started') + ' worker ' + w.ref.harness + ':' + w.ref.session
    + (w.ref.window ? ':' + w.ref.window : '')
    + '\n  worktree: ' + w.worktree.path + (w.branch ? '\n  branch:   ' + w.branch : '')
    + '\n  card ' + id + ' -> working');
}

